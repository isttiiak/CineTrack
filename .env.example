# Public (compiled into the browser bundle)
VITE_FIREBASE_API_KEY=your_value_here
VITE_FIREBASE_AUTH_DOMAIN=your_value_here
VITE_FIREBASE_PROJECT_ID=your_value_here
VITE_FIREBASE_STORAGE_BUCKET=your_value_here
VITE_FIREBASE_MESSAGING_SENDER_ID=your_value_here
VITE_FIREBASE_APP_ID=your_value_here
VITE_FIREBASE_MEASUREMENT_ID=your_value_here
# Optional: Firebase App Check (reCAPTCHA Enterprise site key)
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
# Optional, dev only: a registered App Check debug token
VITE_APPCHECK_DEBUG_TOKEN=

# Server-only (no VITE_ prefix — never sent to the browser). TMDB v3 key or v4 read access token.
TMDB_API_KEY=your_value_here
# Optional, server-only: ratings from IMDb / Rotten Tomatoes / Metacritic / Letterboxd.
# MDBList is preferred (more sources); OMDb is the fallback. Free tiers ~1000 requests/day.
MDBLIST_API_KEY=
OMDB_API_KEY=
